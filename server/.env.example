# ─────────────────────────────────────────────────────────────────────────────
# SITE BACKEND (server/) — copy to server/.env and fill in.
# server/.env is gitignored. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Origin of the frontend. Used for the post-OAuth redirect and CORS.
WEB_ORIGIN=http://localhost:5173

# ── Sessions ────────────────────────────────────────────────────────────────
# Long random value. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# ── Discord OAuth ───────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app → OAuth2.
# DISCORD_REDIRECT_URI must be registered verbatim under OAuth2 → Redirects,
# and must point at THIS server's port (4000 by default), not the Vite port.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/discord/callback
# Right-click your server in Discord (with Developer Mode on) → Copy Server ID
DISCORD_GUILD_ID=

# ── CP-Bot API ──────────────────────────────────────────────────────────────
# Base URL of the running CP-Bot web service (no trailing slash).
BOT_API_URL=http://localhost:10000
# Must match BB_API_KEY set on the bot. Generate with: openssl rand -hex 32
BB_API_KEY=

# ── Databases ───────────────────────────────────────────────────────────────
# Problem/test dataset (Neon or any Postgres).
DATABASE_URL=
# Separate Postgres for the legacy users table. Optional once Discord OAuth
# is the only identity — see README_PHASE1.md.
AUTH_DATABASE_URL=

# ── Optional ────────────────────────────────────────────────────────────────
# Leave unset to disable the legacy Google sign-in button.
GOOGLE_CLIENT_ID=
